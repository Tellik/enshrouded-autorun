{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated ShroudForge installation state",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updates": {
      "type": "object",
      "properties": {
        "missingUpdaterAnnouncement": {
          "type": "object",
          "required": ["lastAttemptAt", "checkedAt", "updateAvailable", "version", "releaseUrl"],
          "properties": {
            "lastAttemptAt": { "type": "integer", "minimum": 0 },
            "checkedAt": { "type": ["integer", "null"], "minimum": 0 },
            "updateAvailable": { "type": "boolean" },
            "version": { "type": ["string", "null"] },
            "releaseUrl": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      }
    },
    "assets": { "type": "object" },
    "runtime": { "type": "object" },
    "diagnostics": { "type": "object" },
    "windows": { "type": "object" },
    "news": { "type": "object" },
    "events": { "type": "object" },
    "catalog": { "type": "object" },
    "mods": { "type": "object" },
    "parser": { "type": "object" },
    "playerName": {
      "type": "object",
      "required": ["lastDetectedName", "cachedAtUnixSeconds"],
      "properties": {
        "lastDetectedName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cachedAtUnixSeconds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
