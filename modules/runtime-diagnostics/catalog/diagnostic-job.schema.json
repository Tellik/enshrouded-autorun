{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShroudForge diagnostic job",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "description": { "type": "string", "maxLength": 240 },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["runtime", "queue", "mods", "operations"] }
    },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "modId", "script"],
          "properties": {
            "kind": { "const": "lua" },
            "modId": { "$ref": "#/$defs/identifier" },
            "script": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.lua$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "modId", "action"],
          "properties": {
            "kind": { "const": "modAction" },
            "modId": { "$ref": "#/$defs/identifier" },
            "action": { "$ref": "#/$defs/identifier" },
            "value": { "type": "string", "maxLength": 65536 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "script"],
          "properties": {
            "kind": { "const": "python" },
            "script": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.py$"
            },
            "args": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "maxLength": 4096 }
            },
            "interpreter": { "type": "string", "minLength": 1, "maxLength": 4096 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "action"],
          "properties": {
            "kind": { "const": "rust" },
            "action": { "enum": ["inspect-system-dependencies"] }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "anyOf": [
    { "properties": { "capabilities": { "minItems": 1 } } },
    { "required": ["execution"] }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$" }
  },
  "additionalProperties": false
}
